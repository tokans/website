# ─────────────────────────────────────────────────────────────────────────────
# Tokans production deploy config.  Copy to .env.deploy.local (gitignored) and
# fill in.  Then run:  npm run deploy   (or  npm run deploy:dry  to preview)
#
# The deploy is idempotent: provide a value to use it as-is, or provide the
# provider API key to have `npm run deploy` provision the resource for you.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: your production URL (custom domain or *.vercel.app) ─────────────
APP_URL=https://tokans.org
# PUBLIC_BASE_URL=https://tokans.org      # defaults to APP_URL

# ── Vercel ───────────────────────────────────────────────────────────────────
# Create at https://vercel.com/account/tokens  (scope: Full Account).
VERCEL_TOKEN=
# Optional — set if the project is already created; otherwise `vercel link` runs.
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Option A (auto-provision): API key from https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
# NEON_PROJECT_NAME=tokans-prod
# Option B (bring your own): paste a connection string and leave NEON_API_KEY blank.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ── Upstash Redis ────────────────────────────────────────────────────────────
# Option A (auto-provision): account email + Management API key
#   https://console.upstash.com/account/api
UPSTASH_EMAIL=
UPSTASH_API_KEY=
# UPSTASH_DB_NAME=tokans-prod
# UPSTASH_REGION=us-east-1
# Option B (bring your own): paste the REST creds and leave the two above blank.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Auto-generated if blank ──────────────────────────────────────────────────
# CRON_SECRET=                # protects /api/cron/snapshot; generated if empty

# ── OPTIONAL: leave blank to ship with safe mock defaults, add later ──────────
# PAYMENTS_MODE=mock          # mock | stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BACKEND_MODE=mock           # mock (Neon-backed) | rest
# BACKEND_REST_URL=
# BACKEND_IDENTITY_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MWA_DOWNLOAD_BASE=
